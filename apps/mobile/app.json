{
  "expo": {
    "name": "RepTel",
    "slug": "reptel-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "reptel",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reptel.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#23262F"
      },
      "package": "com.reptel.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#23262F"
        }
      ],
      "expo-status-bar",
      "expo-sharing"
    ]
  }
}
