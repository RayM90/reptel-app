generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  CASHIER
  TECHNICIAN
  TECHNICIAN_DELIVERY
  DELIVERY
  CLIENT
  MANAGER
  SELLER
}

enum TechnicianStatus {
  AVAILABLE
  BUSY
  SATURATED
  ABSENT
}

enum DeviceType {
  LAPTOP
  PC
}

enum OrderStatus {
  PENDING_PAYMENT
  RECEIVED
  DIAGNOSING
  WAITING_APPROVAL
  APPROVED
  REPAIRING
  WAITING_PART
  READY
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  ASSIGNED
  LEAVING_STORE
  ON_THE_WAY
  AT_LOCATION
  DIAGNOSING_ON_SITE
  EQUIPMENT_PICKED_UP
  AT_THE_SHOP
  RETURNING
  DELIVERED
  CANCELLED
}

enum DocumentType {
  RECEIPT_NOTE
  DELIVERY_NOTE
  WITHDRAWAL_ACT
  ON_SITE_RECEIPT
}

enum PaymentMethod {
  CASH
  TRANSFER
  POINT_OF_SALE
  MOBILE_PAYMENT
  MIXED
  BINANCE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum NotificationType {
  STATUS_CHANGE
  BUDGET_REQUEST
  READY_FOR_PICKUP
  DELIVERY_UPDATE
  PAYMENT_CONFIRMED
  ORDER_CREATED
  GENERAL
}

enum Channel {
  EMAIL
  PUSH
  SMS
}

enum InvoiceType {
  SERVICE
  STORE_PURCHASE
  DELIVERY_SERVICE
}

enum ProductOrderStatus {
  PENDING
  CONFIRMED
  REJECTED
  READY_FOR_PICKUP
  ASSIGNED_DELIVERY
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP_AT_STORE
  HOME_DELIVERY
  TECHNICIAN_DELIVERY
}

enum PartialPaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum InventoryMovementType {
  IN
  OUT
}

// ─────────────────────────────────────────────
// MÓDULO USUARIOS Y CLIENTES
// ─────────────────────────────────────────────

model User {
  id                String           @id @default(uuid())
  name              String
  email             String           @unique
  phone             String?
  password          String
  role              Role             @default(CLIENT)
  isActive          Boolean          @default(true)

  clientId          String?          @unique
  client            Client?          @relation(fields: [clientId], references: [id])

  technicianStatus  TechnicianStatus @default(AVAILABLE)
  activeOrderCount  Int              @default(0)
  maxOrderCapacity  Int              @default(5)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  ordersAsTechnician   Order[]            @relation("TechnicianOrders")
  notifications        Notification[]
  productDeliveries    ProductDelivery[]  @relation("DeliveryAgent")
  statusChangesMade    OrderStatusHistory[] @relation("StatusChangeActor")
  advanceSubmissionsConfirmed AdvancePaymentSubmission[] @relation("AdvanceConfirmedBy")
  productSubmissionsConfirmed ProductOrderPaymentSubmission[] @relation("ProductPaymentConfirmedBy")
  productOrderStatusChangesMade ProductOrderStatusHistory[] @relation("ProductOrderStatusActor")
  inventoryMovementsMade InventoryMovement[]
}

model Client {
  id        String   @id @default(uuid())
  name      String
  lastName  String
  idNumber  String   @unique
  phone     String
  email     String?
  address   String?
  password  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User?
  orders          Order[]
  productOrders   ProductOrder[]
  invoices        Invoice[]
}

// ─────────────────────────────────────────────
// MÓDULO DISPOSITIVOS Y ÓRDENES
// ─────────────────────────────────────────────

model Device {
  id             String     @id @default(uuid())
  type           DeviceType
  brand          String
  model          String
  serialNumber   String?
  color          String?
  accessories    String?
  devicePassword String?
  createdAt      DateTime   @default(now())

  orders Order[]
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  status         OrderStatus @default(RECEIVED)
  problem        String      @db.Text
  diagnosis      String?     @db.Text
  budget         Decimal?    @db.Decimal(10, 2)
  budgetApproved Boolean?
  qrCode         String?     @db.Text
  observations   String?     @db.Text
  receivedAt     DateTime    @default(now())
  deliveredAt    DateTime?
  updatedAt      DateTime    @updatedAt

  deliveryAmount             Decimal?       @db.Decimal(10, 2)
  revisionAmount             Decimal?       @db.Decimal(10, 2)
  advancePaymentMethod       PaymentMethod?
  advanceReceiptUrl          String?
  advancePaymentDetails      Json?
  advancePaymentConfirmed    Boolean        @default(false)
  advancePaymentConfirmedAt  DateTime?
  advancePaymentRejectionReason String?     @db.Text
  advancePaymentSubmissions  AdvancePaymentSubmission[]

  // ── NUEVO: pago final (saldo restante) + comisión del técnico ──
  finalPaymentDetails         Json?
  finalPaymentConfirmed       Boolean        @default(false)
  finalPaymentConfirmedAt     DateTime?
  finalPaymentRejectionReason String?        @db.Text
  technicianCommission        Decimal?       @db.Decimal(10, 2)
  // ─────────────────────────────────────────────────────────────

  clientId     String
  client       Client @relation(fields: [clientId], references: [id])

  technicianId String?
  technician   User?  @relation("TechnicianOrders", fields: [technicianId], references: [id])

  deviceId     String
  device       Device @relation(fields: [deviceId], references: [id])

  serviceCatalogId String?
  serviceCatalog   ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])

  statusHistory    OrderStatusHistory[]
  notifications    Notification[]
  documents        ServiceDocument[]
  payments         ServicePayment[]
  invoices         Invoice[]

  linkedProductOrders ProductOrder[] @relation("ProductOrderToServiceOrder")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  status    OrderStatus
  comment   String?
  createdAt DateTime    @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  userId String?
  user   User?   @relation("StatusChangeActor", fields: [userId], references: [id])
}

// ─────────────────────────────────────────────
// MÓDULO DOCUMENTOS Y PAGOS
// ─────────────────────────────────────────────

model ServiceDocument {
  id           String       @id @default(uuid())
  type         DocumentType
  pdfUrl       String?
  printed      Boolean      @default(false)

  clientSignature String?   @db.Text

  gpsLatitude   Decimal?    @db.Decimal(10, 7)
  gpsLongitude  Decimal?    @db.Decimal(10, 7)

  generatedAt  DateTime     @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
}

model ServicePayment {
  id            String        @id @default(uuid())
  amount        Decimal       @db.Decimal(10, 2)
  amountBs      Decimal?      @db.Decimal(12, 2)
  exchangeRate  Decimal?      @db.Decimal(10, 4)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  reference     String?
  description   String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  invoice Invoice?
}

model Invoice {
  id             String      @id @default(uuid())
  invoiceNumber  String      @unique
  controlNumber  String?
  series         String?     @default("A")
  type           InvoiceType
  subtotal       Decimal     @db.Decimal(10, 2)
  igtfBase       Decimal?    @db.Decimal(10, 2)
  igtfAmount     Decimal?    @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  totalBs        Decimal?    @db.Decimal(12, 2)
  exchangeRate   Decimal?    @db.Decimal(10, 4)
  pdfUrl         String?
  sentByEmail    Boolean     @default(false)
  sentAt         DateTime?
  createdAt      DateTime    @default(now())

  orderId        String?
  order          Order?      @relation(fields: [orderId], references: [id])

  servicePaymentId String?   @unique
  servicePayment   ServicePayment? @relation(fields: [servicePaymentId], references: [id])

  productOrderId String?     @unique
  productOrder   ProductOrder? @relation(fields: [productOrderId], references: [id])

  clientId       String
  client         Client      @relation(fields: [clientId], references: [id])
}

// ─────────────────────────────────────────────
// MÓDULO CATÁLOGO DE SERVICIOS
// ─────────────────────────────────────────────

model ServiceCatalog {
  id                String   @id @default(uuid())
  name              String
  description       String?  @db.Text
  basePrice         Decimal  @db.Decimal(10, 2)
  isOnSiteResolvable Boolean @default(false)
  isActive          Boolean  @default(true)
  estimatedMinutes  Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orders            Order[]

  @@map("servicecatalog")
}

// ─────────────────────────────────────────────
// MÓDULO TIENDA
// ─────────────────────────────────────────────

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  products  Product[]

  @@map("productcategory")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  minStock    Int      @default(3)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id])

  orderItems  ProductOrderItem[]

  requiresInstallation Boolean @default(false)

  movements   InventoryMovement[]

  @@map("product")
}

model ProductOrder {
  id             String             @id @default(uuid())
  status         ProductOrderStatus @default(PENDING)
  deliveryMethod DeliveryMethod
  address        String?
  deliveryCost   Decimal?           @db.Decimal(10, 2)
  total          Decimal            @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  paidAt         DateTime?
  receiptUrl     String?
  paymentDetails Json?
  notes          String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  rejectionReason String? @db.Text

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  requiresInstallation Boolean  @default(false)
  installationCost     Decimal? @db.Decimal(10, 2)

  linkedOrderId String?
  linkedOrder   Order?  @relation("ProductOrderToServiceOrder", fields: [linkedOrderId], references: [id])

  items              ProductOrderItem[]
  delivery           ProductDelivery?
  invoice            Invoice?
  notifications      Notification[]
  paymentSubmissions ProductOrderPaymentSubmission[]
  statusHistory      ProductOrderStatusHistory[]

  @@map("productorder")
}

model ProductOrderStatusHistory {
  id        String             @id @default(uuid())
  status    ProductOrderStatus
  comment   String?
  createdAt DateTime           @default(now())

  productOrderId String
  productOrder   ProductOrder @relation(fields: [productOrderId], references: [id])

  userId String?
  user   User?   @relation("ProductOrderStatusActor", fields: [userId], references: [id])

  @@map("productorderstatushistory")
}

model ProductOrderItem {
  id         String  @id @default(uuid())
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(10, 2)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productOrderId String
  productOrder   ProductOrder @relation(fields: [productOrderId], references: [id])

  @@map("productorderitem")
}

model ProductOrderPaymentSubmission {
  id                 String               @id @default(uuid())
  amount             Decimal              @db.Decimal(10, 2)
  paymentDetails     Json
  status             PartialPaymentStatus @default(PENDING)
  rejectionReason    String?              @db.Text
  createdAt          DateTime             @default(now())
  confirmedAt        DateTime?

  productOrderId     String
  productOrder       ProductOrder         @relation(fields: [productOrderId], references: [id])

  confirmedByUserId  String?
  confirmedByUser    User?                @relation("ProductPaymentConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@map("productorderpaymentsubmission")
}

// Historial de movimientos de inventario — registra cada vez que el stock
// de un Product cambia (creación, ajuste manual, venta, cancelación) para
// dejar rastro de por qué cambió, sin exponer reportes ni endpoints nuevos.
model InventoryMovement {
  id        String                 @id @default(uuid())
  type      InventoryMovementType
  quantity  Int
  reason    String
  createdAt DateTime               @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@map("inventorymovement")
}

// Abonos parciales del anticipo de Servicio Técnico ($25 = delivery + revisión).
// Mismo patrón que ProductOrderPaymentSubmission: cada envío es un registro
// independiente, el cliente puede pagar en varias partes y no puede enviar
// más de lo que falta para completar el total.
model AdvancePaymentSubmission {
  id                 String               @id @default(uuid())
  amount             Decimal              @db.Decimal(10, 2)
  paymentDetails     Json
  status             PartialPaymentStatus @default(PENDING)
  rejectionReason    String?              @db.Text
  createdAt          DateTime             @default(now())
  confirmedAt        DateTime?

  orderId            String
  order              Order                @relation(fields: [orderId], references: [id])

  confirmedByUserId  String?
  confirmedByUser    User?                @relation("AdvanceConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@map("advancepaymentsubmission")
}

model ProductDelivery {
  id             String         @id @default(uuid())
  status         DeliveryStatus @default(ASSIGNED)
  gpsLatitude    Decimal?       @db.Decimal(10, 7)
  gpsLongitude   Decimal?       @db.Decimal(10, 7)
  photoUrl       String?
  deliveredAt    DateTime?
  deliveryCommission Decimal?   @db.Decimal(10, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  clientConfirmedAt DateTime?

  productOrderId String       @unique
  productOrder   ProductOrder @relation(fields: [productOrderId], references: [id])

  agentId String
  agent   User   @relation("DeliveryAgent", fields: [agentId], references: [id])

  @@map("productdelivery")
}

// ─────────────────────────────────────────────
// MÓDULO CONFIGURACIÓN DEL NEGOCIO
// ─────────────────────────────────────────────

// Datos de pago de la tienda (banco, teléfono Pago Móvil, cédula, cuenta
// bancaria, RIF, wallet Binance) — antes hardcodeados como constantes
// idénticas duplicadas en 4 archivos del frontend móvil (advance-payment.tsx,
// checkout.tsx, final-payment.tsx, link-checkout.tsx). Se centralizan aquí
// para que el ADMIN los edite en un solo lugar sin recompilar la app.
model BusinessSettings {
  id                     String   @id @default(uuid())
  pagoMovilBanco         String
  pagoMovilTelefono      String
  pagoMovilCedula        String
  transferenciaBanco     String
  transferenciaCuenta    String
  transferenciaRif       String
  binanceId              String
  binanceRed             String
  updatedAt              DateTime @updatedAt

  @@map("businesssettings")
}

// ─────────────────────────────────────────────
// MÓDULO NOTIFICACIONES
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  channel   Channel
  message   String           @db.Text
  sent      Boolean          @default(false)
  sentAt    DateTime?
  createdAt DateTime         @default(now())

  orderId        String?
  order          Order?  @relation(fields: [orderId], references: [id])

  productOrderId String?
  productOrder   ProductOrder? @relation(fields: [productOrderId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("notification")
}