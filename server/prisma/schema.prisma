generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  CASHIER
  TECHNICIAN
  TECHNICIAN_DELIVERY
  CLIENT
  MANAGER
}

enum TechnicianStatus {
  AVAILABLE
  BUSY
  SATURATED
  ABSENT
}

enum DeviceType {
  LAPTOP
  PC
}

enum OrderStatus {
  PENDING_PAYMENT
  RECEIVED
  DIAGNOSING
  WAITING_APPROVAL
  APPROVED
  REPAIRING
  WAITING_PART
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  POINT_OF_SALE
  MOBILE_PAYMENT
  MIXED
  BINANCE
}

enum PartialPaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum InventoryMovementType {
  IN
  OUT
}

// Por dónde salió/entró el producto. Hoy solo existe MOSTRADOR (única vía real
// de venta); SERVICIO_TECNICO queda reservado para si se reintroduce el flujo
// de repuesto vinculado a una orden (eliminado en el sub-proyecto de
// remoción de tienda online).
enum InventoryChannel {
  MOSTRADOR
  SERVICIO_TECNICO
}

// ─────────────────────────────────────────────
// MÓDULO USUARIOS Y CLIENTES
// ─────────────────────────────────────────────

model User {
  id                String           @id @default(uuid())
  name              String
  lastName          String?
  idNumber          String?          @unique
  email             String           @unique
  phone             String?
  password          String
  role              Role             @default(CLIENT)
  isActive          Boolean          @default(true)

  clientId          String?          @unique
  client            Client?          @relation(fields: [clientId], references: [id])

  technicianStatus  TechnicianStatus @default(AVAILABLE)
  activeOrderCount  Int              @default(0)
  maxOrderCapacity  Int              @default(5)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  ordersAsTechnician   Order[]            @relation("TechnicianOrders")
  statusChangesMade    OrderStatusHistory[] @relation("StatusChangeActor")
  advanceSubmissionsConfirmed AdvancePaymentSubmission[] @relation("AdvanceConfirmedBy")
  inventoryMovementsMade InventoryMovement[]
}

model Client {
  id        String   @id @default(uuid())
  name      String
  lastName  String
  idNumber  String   @unique
  phone     String
  email     String?
  addressState        String?
  addressCity         String?
  addressNeighborhood String?
  addressStreet       String?
  addressBuilding     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User?
  orders          Order[]
}

// ─────────────────────────────────────────────
// MÓDULO DISPOSITIVOS Y ÓRDENES
// ─────────────────────────────────────────────

model Device {
  id             String     @id @default(uuid())
  type           DeviceType
  brand          String
  model          String
  serialNumber   String?    @unique
  color          String?
  accessories    String?
  devicePassword String?
  createdAt      DateTime   @default(now())

  orders Order[]
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  status         OrderStatus @default(RECEIVED)
  problem        String      @db.Text
  diagnosis      String?     @db.Text
  budget         Decimal?    @db.Decimal(10, 2)
  budgetApproved Boolean?
  observations   String?     @db.Text
  receivedAt     DateTime    @default(now())
  deliveredAt    DateTime?
  updatedAt      DateTime    @updatedAt
  version        Int         @default(0)

  deliveryAmount             Decimal?       @db.Decimal(10, 2)
  revisionAmount             Decimal?       @db.Decimal(10, 2)
  advancePaymentMethod       PaymentMethod?
  advancePaymentSubmissions  AdvancePaymentSubmission[]

  // ── NUEVO: pago final (saldo restante) + comisión del técnico ──
  finalPaymentDetails         Json?
  finalPaymentConfirmed       Boolean        @default(false)
  finalPaymentConfirmedAt     DateTime?
  finalPaymentRejectionReason String?        @db.Text
  technicianCommission        Decimal?       @db.Decimal(10, 2)
  // ─────────────────────────────────────────────────────────────

  clientId     String
  client       Client @relation(fields: [clientId], references: [id])

  technicianId String?
  technician   User?  @relation("TechnicianOrders", fields: [technicianId], references: [id])

  deviceId     String
  device       Device @relation(fields: [deviceId], references: [id])

  serviceCatalogId String?
  serviceCatalog   ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])

  statusHistory    OrderStatusHistory[]

  @@index([status, deliveredAt])
  @@index([receivedAt])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  status    OrderStatus
  comment   String?
  createdAt DateTime    @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  userId String?
  user   User?   @relation("StatusChangeActor", fields: [userId], references: [id])
}

// ─────────────────────────────────────────────
// MÓDULO CATÁLOGO DE SERVICIOS
// ─────────────────────────────────────────────

model ServiceCatalog {
  id                String   @id @default(uuid())
  name              String
  description       String?  @db.Text
  basePrice         Decimal  @db.Decimal(10, 2)
  isOnSiteResolvable Boolean @default(false)
  isActive          Boolean  @default(true)
  estimatedMinutes  Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orders            Order[]

  @@map("servicecatalog")
}

// ─────────────────────────────────────────────
// MÓDULO TIENDA FÍSICA — catálogo e inventario (mostrador, sin checkout online)
// ─────────────────────────────────────────────

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  products  Product[]

  @@map("productcategory")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  minStock    Int      @default(3)
  imageUrl    String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id])

  requiresInstallation Boolean @default(false)

  movements   InventoryMovement[]

  @@map("product")
}

// Historial de movimientos de inventario — registra cada vez que el stock
// de un Product cambia (creación, ajuste manual, venta, cancelación) para
// dejar rastro de por qué cambió, sin exponer reportes ni endpoints nuevos.
model InventoryMovement {
  id        String                 @id @default(uuid())
  type      InventoryMovementType
  channel   InventoryChannel       @default(MOSTRADOR)
  quantity  Int
  reason    String
  createdAt DateTime               @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@map("inventorymovement")
}

// Abonos parciales del anticipo de Servicio Técnico ($25 = delivery + revisión).
// Cada envío es un registro independiente, el cliente puede pagar en varias
// partes y no puede enviar más de lo que falta para completar el total.
model AdvancePaymentSubmission {
  id                 String               @id @default(uuid())
  amount             Decimal              @db.Decimal(10, 2)
  paymentDetails     Json
  status             PartialPaymentStatus @default(PENDING)
  rejectionReason    String?              @db.Text
  createdAt          DateTime             @default(now())
  confirmedAt        DateTime?

  orderId            String
  order              Order                @relation(fields: [orderId], references: [id])

  confirmedByUserId  String?
  confirmedByUser    User?                @relation("AdvanceConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@map("advancepaymentsubmission")
}

// ─────────────────────────────────────────────
// MÓDULO CONFIGURACIÓN DEL NEGOCIO
// ─────────────────────────────────────────────

// Datos de pago de la tienda (banco, teléfono Pago Móvil, cédula, cuenta
// bancaria, RIF, wallet Binance) — antes hardcodeados como constantes
// idénticas duplicadas en 4 archivos del frontend móvil (advance-payment.tsx,
// checkout.tsx, final-payment.tsx, link-checkout.tsx). Se centralizan aquí
// para que el ADMIN los edite en un solo lugar sin recompilar la app.
model BusinessSettings {
  id                     String   @id @default(uuid())
  pagoMovilBanco         String
  pagoMovilTelefono      String
  pagoMovilCedula        String
  transferenciaBanco     String
  transferenciaCuenta    String
  transferenciaRif       String
  binanceId              String
  binanceRed             String
  updatedAt              DateTime @updatedAt

  @@map("businesssettings")
}
