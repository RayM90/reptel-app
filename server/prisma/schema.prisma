generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
  TECHNICIAN
  DELIVERY
  CLIENT
  MANAGER
  SELLER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(CLIENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersAsTechnician  Order[]            @relation("TechnicianOrders")
  notifications       Notification[]
  deliveryAssignments DeliveryTracking[] @relation("DeliveryUser")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  lastName  String
  idNumber  String   @unique
  phone     String
  email     String?
  address   String?
  password  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders          Order[]
  serviceRequests ServiceRequest[]
}

model Device {
  id             String     @id @default(uuid())
  type           DeviceType
  brand          String
  model          String
  serialNumber   String?
  color          String?
  accessories    String?
  devicePassword String?
  createdAt      DateTime   @default(now())

  orders Order[]
}

enum DeviceType {
  LAPTOP
  PC
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  status         OrderStatus @default(RECEIVED)
  problem        String      @db.Text
  diagnosis      String?     @db.Text
  budget         Decimal?    @db.Decimal(10, 2)
  budgetApproved Boolean?
  qrCode         String?     @db.Text
  observations   String?     @db.Text
  receivedAt     DateTime    @default(now())
  deliveredAt    DateTime?
  updatedAt      DateTime    @updatedAt

  clientId     String
  client       Client @relation(fields: [clientId], references: [id])

  technicianId String?
  technician   User?  @relation("TechnicianOrders", fields: [technicianId], references: [id])

  deviceId     String
  device       Device @relation(fields: [deviceId], references: [id])

  serviceRequestId String?         @unique
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])

  statusHistory OrderStatusHistory[]
  notifications Notification[]
  documents     ServiceDocument[]
}

enum OrderStatus {
  RECEIVED
  DIAGNOSING
  WAITING_APPROVAL
  APPROVED
  REPAIRING
  READY
  DELIVERED
  CANCELLED
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  status    OrderStatus
  comment   String?
  createdAt DateTime    @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
}

model ServiceRequest {
  id            String        @id @default(uuid())
  type          ServiceType
  status        RequestStatus @default(PENDING)
  deviceType    DeviceType
  brand         String
  description   String        @db.Text
  address       String?
  paymentMethod PaymentMethod
  deliveryCost  Decimal?      @db.Decimal(10, 2)
  tip           Decimal?      @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  order            Order?
  deliveryTracking DeliveryTracking?
}

enum ServiceType {
  PRESENCIAL
  DELIVERY
}

enum RequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  POINT_OF_SALE
}

model DeliveryTracking {
  id        String         @id @default(uuid())
  status    DeliveryStatus @default(ASSIGNED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  serviceRequestId String         @unique
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  deliveryUserId String
  deliveryUser   User   @relation("DeliveryUser", fields: [deliveryUserId], references: [id])

  photos DeliveryPhoto[]
}

enum DeliveryStatus {
  ASSIGNED
  LEAVING_STORE
  ON_THE_WAY
  EQUIPMENT_PICKED_UP
  AT_THE_SHOP
  RETURNING
  DELIVERED
  CANCELLED
}

model DeliveryPhoto {
  id                 String    @id @default(uuid())
  url                String
  type               PhotoType
  confirmedByClient  Boolean   @default(false)
  confirmedByCashier Boolean   @default(false)
  createdAt          DateTime  @default(now())

  deliveryTrackingId String
  deliveryTracking   DeliveryTracking @relation(fields: [deliveryTrackingId], references: [id])
}

enum PhotoType {
  PICKUP
  DELIVERY
}

model ServiceDocument {
  id          String       @id @default(uuid())
  type        DocumentType
  pdfUrl      String?
  printed     Boolean      @default(false)
  generatedAt DateTime     @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
}

enum DocumentType {
  RECEIPT_NOTE
  DELIVERY_NOTE
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  channel   Channel
  message   String           @db.Text
  sent      Boolean          @default(false)
  sentAt    DateTime?
  createdAt DateTime         @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

enum NotificationType {
  STATUS_CHANGE
  BUDGET_REQUEST
  READY_FOR_PICKUP
  DELIVERY_UPDATE
  GENERAL
}

enum Channel {
  EMAIL
  PUSH
}